# Entorno virtual: guarda rutas absolutas del equipo; se recrea con requirements.txt
.venv/

# Índices del RAG: el de Qdrant pesa ~83 MB y crece con el corpus (GitHub
# rechaza archivos de más de 100 MB). BM25 se excluye con él porque ambos se
# regeneran juntos:  cd rag_pipeline && python -m rag.index
rag_pipeline/indices/

# Planilla de revisión médica: se regenera con scripts/exportar_revision.py, y
# clave.csv (qué respuesta es cuál) no debe viajar junto a la planilla.
rag_pipeline/eval/revision/

# Fuentes crudas: trauma.csv tiene PHI y los libros tienen derechos de autor y
# pesan más de lo que admite GitHub (el manual pesa 185 MB).
anonimizacion/data/
# Texto extraído de los libros: solo se versiona el perfil de extracción.
rag_pipeline/guias/*
!rag_pipeline/guias/perfiles.yaml

# Cachés de Python y pytest (se regeneran solas)
__pycache__/
.pytest_cache/
